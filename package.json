{
  "name": "clocktower-developers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer portal for Clocktower REST API and MCP keys",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "wrangler dev src/server/index.ts --port 8788",
    "build": "tsc -p tsconfig.client.json --noEmit && vite build && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply clocktower-developers --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "tinypool": ">=2.1.2 <3",
    "undici": ">=7.30.1",
    "sharp": ">=0.35.5",
    "source-map-js": ">=1.2.2 <2",
    "launch-editor": ">=2.14.2 <3",
    "shell-quote": ">=1.11.0 <2",
    "esbuild": ">=0.28.1"
  }
}
