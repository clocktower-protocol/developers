{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clocktower-developers",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CLOCKTOWER_API_BASE": "https://api.clocktower.finance",
    "PUBLIC_APP_ORIGIN": "https://developers.clocktower.finance",
    "EMAIL_FROM": "noreply@clocktower.finance"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clocktower-developers",
      "database_id": "9ba8a066-951e-42fd-8cc6-0fa280000d6a",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
