# Copy to .dev.vars (gitignored). Never use VITE_ for secrets.

CLOCKTOWER_API_BASE=http://127.0.0.1:8787
DEVELOPER_KEYS_ADMIN_SECRET=replace-with-same-secret-as-api-min-32-chars
SESSION_SECRET=replace-with-random-32-byte-hex-or-longer-string
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173

# OAuth apps — callback URL:
#   http://127.0.0.1:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email magic links via Cloudflare Email Service (send_email binding EMAIL).
# EMAIL_FROM must be a verified sender on the onboarded domain (same as caller SENDER_ADDRESS).
# EMAIL_DEV_ECHO=true returns the link in JSON and skips sending (local only).
EMAIL_FROM=noreply@clocktower.finance
EMAIL_DEV_ECHO=true
